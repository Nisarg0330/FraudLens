# ========================
# FraudLens Environment Variables
# Copy this to .env: cp .env.example .env
# ========================

# Database
DATABASE_URL=postgresql+asyncpg://fraudlens:localdev123@localhost:5432/fraudlens
POSTGRES_USER=fraudlens
POSTGRES_PASSWORD=localdev123
POSTGRES_DB=fraudlens

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
ENVIRONMENT=development
DEBUG=true
API_KEY=dev-api-key-change-in-production
SECRET_KEY=change-this-in-production-use-a-random-string

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ML
MODEL_VERSION=v1.0.0
ONNX_MODEL_PATH=./ml_models/onnx/

# Mapbox (Deep will add this)
VITE_MAPBOX_TOKEN=your-mapbox-token-here